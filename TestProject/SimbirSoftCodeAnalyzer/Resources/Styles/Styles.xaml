<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:SimbirSoftCodeAnalyzer.Managers">

    <!-- ========================================== -->
    <!--           ЦВЕТА (COLORS)                    -->
    <!-- ========================================== -->

    <!-- Primary Blue -->
    <Color x:Key="PrimaryLightColor">#166CFB</Color>
    <!-- Blue 100 -->
    <Color x:Key="PrimaryColor">#134BC5</Color>
    <!-- Blue 200 -->
    <Color x:Key="PrimaryDarkColor">#08398A</Color>
    <!-- Blue 300 -->
    <Color x:Key="PrimaryDeepColor">#041733</Color>
    <!-- Blue 400 -->

    <SolidColorBrush x:Key="Gray100Brush" Color="{DynamicResource Gray100}"/>

    <!-- Accent Yellow -->
    <Color x:Key="AccentLightColor">#FCE385</Color>
    <!-- Yellow 100 -->
    <Color x:Key="AccentColor">#F4BE44</Color>
    <!-- Yellow 200 -->
    <Color x:Key="AccentDarkColor">#F19236</Color>
    <!-- Yellow 300 -->

    <!-- Accent Red -->
    <Color x:Key="DangerLightColor">#FF3838</Color>
    <!-- Red 000 -->
    <Color x:Key="DangerColor">#DE1841</Color>
    <!-- Red 100 -->
    <Color x:Key="DangerDarkColor">#CA1238</Color>
    <!-- Red 200 -->

    <!-- Gray Scale -->
    <Color x:Key="Gray100">#F7F7F9</Color>
    <Color x:Key="Gray200">#B8BABF</Color>
    <Color x:Key="Gray500">#595A5B</Color>
    <Color x:Key="Gray600">#333437</Color>
    <Color x:Key="Gray700">#252628</Color>
    <Color x:Key="Gray800">#202123</Color>
    <Color x:Key="Black900">#17181A</Color>
    <Color x:Key="Black1000">#0F1010</Color>

    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessBgColor">#D1FAE5</Color>
    <Color x:Key="WarningColor">#F19236</Color>
    <!-- Yellow 300 -->
    <Color x:Key="WarningBgColor">#FEF9C3</Color>
    <Color x:Key="DangerBgColor">#FEE2E2</Color>

    <!-- Text & Background -->
    <Color x:Key="DarkTextColor">#0F1010</Color>
    <!-- Black 1000 -->
    <Color x:Key="SecondaryTextColor">#595A5B</Color>
    <!-- Gray 500 -->
    <Color x:Key="GlobalBackgroundColor">#F7F7F9</Color>
    <!-- Gray 100 -->
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="HoverColor">#EEF2FF</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarBackgroundColor">#0F1010</Color>
    <!-- Black 1000 -->
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarHoverColor">#252628</Color>
    <!-- Gray 700 -->
    <Color x:Key="SidebarActiveColor">#134BC5</Color>
    <!-- Blue 200 -->

    <!-- ========================================== -->
    <!--                КИСТИ (BRUSHES)             -->
    <!-- ========================================== -->

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{DynamicResource PrimaryDeepColor}"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{DynamicResource AccentDarkColor}"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerLightBrush" Color="{DynamicResource DangerLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{DynamicResource DangerDarkColor}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="DarkTextBrush" Color="{DynamicResource DarkTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="GlobalBackgroundBrush" Color="{DynamicResource GlobalBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{DynamicResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{DynamicResource SidebarActiveColor}"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{DynamicResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{DynamicResource WarningBgColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{DynamicResource DangerBgColor}"/>

    <!-- Legacy compatibility -->
    <SolidColorBrush x:Key="AccentPaleBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#166CFB"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#DBEAFE"/>

    <!-- ========================================== -->
    <!--            РАЗМЕРЫ (SCALES)                -->
    <!-- ========================================== -->

    <sys:Double x:Key="SmallScale">0.8</sys:Double>
    <sys:Double x:Key="MediumScale">1.0</sys:Double>
    <sys:Double x:Key="LargeScale">1.2</sys:Double>

    <sys:Double x:Key="SmallIconWidth">16</sys:Double>
    <sys:Double x:Key="SmallIconHeight">16</sys:Double>
    <sys:Double x:Key="MediumIconWidth">20</sys:Double>
    <sys:Double x:Key="MediumIconHeight">20</sys:Double>
    <sys:Double x:Key="LargeIconWidth">24</sys:Double>
    <sys:Double x:Key="LargeIconHeight">24</sys:Double>

    <sys:Double x:Key="SmallButtonIconWidth">24</sys:Double>
    <sys:Double x:Key="SmallButtonIconHeight">24</sys:Double>
    <sys:Double x:Key="MediumButtonIconWidth">30</sys:Double>
    <sys:Double x:Key="MediumButtonIconHeight">30</sys:Double>
    <sys:Double x:Key="LargeButtonIconWidth">36</sys:Double>
    <sys:Double x:Key="LargeButtonIconHeight">36</sys:Double>

    <sys:Double x:Key="SmallAppFontSizeBig">28</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH1">20</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH2">18</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH3">16</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH4">14</sys:Double>
    <sys:Double x:Key="SmallWindowFormFontSize">12</sys:Double>

    <sys:Double x:Key="MediumAppFontSizeBig">36</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH1">24</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH2">22</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH3">20</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH4">18</sys:Double>
    <sys:Double x:Key="MediumWindowFormFontSize">14</sys:Double>

    <sys:Double x:Key="LargeAppFontSizeBig">44</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH1">28</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH2">26</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH3">24</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH4">22</sys:Double>
    <sys:Double x:Key="LargeWindowFormFontSize">16</sys:Double>

    <!-- Defaults -->
    <sys:Double x:Key="DefaultIconWidth">20</sys:Double>
    <sys:Double x:Key="DefaultIconHeight">20</sys:Double>
    <sys:Double x:Key="ButtonIconWidth">30</sys:Double>
    <sys:Double x:Key="ButtonIconHeight">30</sys:Double>

    <sys:Double x:Key="AppFontSizeBig">36</sys:Double>
    <sys:Double x:Key="AppFontSizeH1">24</sys:Double>
    <sys:Double x:Key="AppFontSizeH2">22</sys:Double>
    <sys:Double x:Key="AppFontSizeH3">20</sys:Double>
    <sys:Double x:Key="AppFontSizeH4">18</sys:Double>
    <sys:Double x:Key="WindowFormFontSize">14</sys:Double>

    <!-- ========================================== -->
    <!--               ОБЩИЕ СТИЛИ ОКНА             -->
    <!-- ========================================== -->

    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="FontSize" Value="{DynamicResource WindowFormFontSize}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RoundedWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource GlobalBackgroundBrush}"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource GlobalBackgroundBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка -->
                            <Border x:Name="HeaderBorder"
                                Grid.Row="0"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Title}"
                                           VerticalAlignment="Center"
                                           Margin="15,0"
                                           Foreground="{DynamicResource DarkTextBrush}"
                                           FontSize="14"
                                           FontFamily="Inter"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="MinimizeButton"
                                            Content="─"
                                            Foreground="{DynamicResource DarkTextBrush}"
                                            Style="{StaticResource WindowControlButtonStyle}"/>
                                        <Button x:Name="MaximizeButton"
                                            Content="□"
                                            Foreground="{DynamicResource DarkTextBrush}"
                                            Style="{StaticResource WindowControlButtonStyle}"/>
                                        <Button x:Name="CloseButton"
                                            Content="×"
                                            Foreground="{DynamicResource DarkTextBrush}"
                                            Style="{StaticResource WindowControlButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Контент -->
                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================== -->
    <!--             СТИЛИ ТЕКСТА                   -->
    <!-- ========================================== -->

    <Style x:Key="MainText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBig}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Стиль для блока кода -->
    <Style x:Key="CodeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH1}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH2}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H4Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SidebarTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH1}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SidebarSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="#B3B3B3"/>
    </Style>

    <!-- ========================================== -->
    <!--            СТИЛИ КНОПОК                    -->
    <!-- ========================================== -->

    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="25,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#6D7CFD"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryTextBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary/Outline Button -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="25,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#EF4444"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="White" TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary/Neutral Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="#EDF2F6"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost/Link Button -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontWeight="Normal"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ========================================== -->
    <!--            СТИЛЬ TEXTBOX                   -->
    <!-- ========================================== -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#F6F8F9"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EDF2F6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ========================================== -->
    <!--        СТИЛИ БОКОВОЙ ПАНЕЛИ (SIDEBAR)      -->
    <!-- ========================================== -->

    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarActiveButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ========================================== -->
    <!--           СТИЛИ ПОЛЕЙ ВВОДА                -->
    <!-- ========================================== -->

    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="PasswordChar" Value="•"/>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Input Border (контейнер для поля ввода) -->
    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="#F6F8F9"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- Input Border с фокусом (для интерактивных полей) -->
    <Style x:Key="InputBorderFocused" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.1" Color="#6D7CFD"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--              СТИЛИ DATAGRID                -->
    <!-- ========================================== -->

    <Style x:Key="DataGridCardBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmartDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="RowHeight" Value="48"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>

        <!-- Шапка таблицы -->
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="Inter"/>
                    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E8ECF0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- Ячейки -->
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
                    <Setter Property="FontFamily" Value="Inter"/>
                    <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- Строки -->
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Статус-пилюля (Badge) -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusBadgeActive" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
    </Style>

    <Style x:Key="StatusBadgeInactive" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
    </Style>

    <Style x:Key="StatusBadgePending" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
    </Style>

    <!-- ========================================== -->
    <!--            СТИЛИ COMBOBOX                   -->
    <!-- ========================================== -->
    <!-- ComboBoxItem -->
    <Style x:Key="CustomComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ========================================== -->
    <!--            СТИЛИ CHECKBOX                   -->
    <!-- ========================================== -->

    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OuterBorder"
                            Grid.Column="0"
                            Width="20" Height="20"
                            Background="White"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            Margin="0,0,8,0">
                            <Path x:Name="CheckMark"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Fill="White"
                              Data="M0,6 L3,9 L9,3 L8,2 L3,7 L1,5 Z"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--             СТИЛИ КАРТОЧЕК                 -->
    <!-- ========================================== -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetricCardBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinHeight" Value="130"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--        СТАТУС-МЕТКИ (BADGES)               -->
    <!-- ========================================== -->

    <Style x:Key="SuccessBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="WarningBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="DangerBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="InfoBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentPaleBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ========================================== -->
    <!--           PROGRESS BAR                     -->
    <!-- ========================================== -->

    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Background" Value="#EDF2F6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            BorderThickness="0">
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.3" Color="#6D7CFD"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!--            SEPARATOR                        -->
    <!-- ========================================== -->

    <Style x:Key="SidebarSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#444444"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- Стиль пункта бокового меню (светлая тема) -->
    <Style x:Key="SidebarItemButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="FontFamily" Value="Inter"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <!-- БЕЗ триггеров — нет эффекта при наведении -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль иконки меню с динамическим цветом -->
    <Style x:Key="MenuIconStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="RadiusX" Value="0"/>
        <Setter Property="RadiusY" Value="0"/>
    </Style>

    <!-- Активный пункт меню -->
    <Style x:Key="SidebarActiveItemButton" TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Tag" Value="Active"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>    
</ResourceDictionary>