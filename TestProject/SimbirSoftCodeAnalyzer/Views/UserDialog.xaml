<Window x:Class="SimbirSoftCodeAnalyzer.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Width="450" Height="870"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" Icon="/Resources/Images/logo-simbirsoft.png"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="LoginBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Пароль:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="PasswordBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Text="Фамилия:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5" x:Name="LastNameBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="6" Text="Имя:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="7" x:Name="FirstNameBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="8" Text="Отчество:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="9" x:Name="MiddleNameBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="10" x:Name="RoleLabel" Text="Роль:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="11" x:Name="RoleCombo" Style="{StaticResource CustomComboBox}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="12" Text="Статус:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="13" x:Name="StatusCombo" Style="{StaticResource CustomComboBox}" Margin="0,0,0,12">
            <ComboBoxItem Content="Активен" Tag="True"/>
            <ComboBoxItem Content="Неактивен" Tag="False"/>
        </ComboBox>
        <TextBlock Grid.Row="14" Text="Наставник:" Style="{StaticResource H4Text}" Margin="0,0,0,4"
           x:Name="MentorLabel" Visibility="Collapsed"/>
        <ComboBox Grid.Row="15" x:Name="MentorCombo" Style="{StaticResource CustomComboBox}" Margin="0,0,0,12"
          Visibility="Collapsed"/>
        <Button Grid.Row="16" Content="Сохранить" Style="{StaticResource PrimaryButton}"
        Click="SaveButton_Click" HorizontalAlignment="Right" Padding="20,8"
        FontSize="{DynamicResource AppFontSizeH4}"/>
    </Grid>
</Window>