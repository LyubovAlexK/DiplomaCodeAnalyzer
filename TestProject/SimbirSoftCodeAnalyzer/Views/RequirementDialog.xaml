<Window x:Class="SimbirSoftCodeAnalyzer.Views.RequirementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Требование" Width="500" Height="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" Icon="/Resources/Images/logo-simbirsoft.png"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Тип:" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,0,6"/>
        <ComboBox Grid.Row="1" x:Name="TypeCombo" Style="{StaticResource CustomComboBox}" Margin="0,0,0,12">
            <ComboBoxItem Content="Функциональное" Tag="Functional"/>
            <ComboBoxItem Content="Архитектурное" Tag="Architectural"/>
            <ComboBoxItem Content="Метрика" Tag="Metric"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Название:" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" x:Name="TitleBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Text="Описание:" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,0,6"/>
        <TextBox Grid.Row="5" x:Name="DescBox" Style="{StaticResource ModernTextBoxStyle}"
                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                    Padding="20,8" FontSize="{DynamicResource AppFontSizeH4}"/>
        </StackPanel>
    </Grid>
</Window>