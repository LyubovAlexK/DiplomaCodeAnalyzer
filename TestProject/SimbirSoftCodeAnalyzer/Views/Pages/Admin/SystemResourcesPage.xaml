<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Admin.SystemResourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Системные ресурсы" Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- Вкладки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="TabMetrics" Content="Метрики" GroupName="Tabs" IsChecked="True"
                             Checked="Tab_Checked" Margin="0,0,16,0"
                             FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                             Foreground="{DynamicResource DarkTextBrush}"/>
                <RadioButton x:Name="TabMarkers" Content="Маркеры" GroupName="Tabs"
                             Checked="Tab_Checked" Margin="0,0,16,0"
                             FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                             Foreground="{DynamicResource DarkTextBrush}"/>
                <RadioButton x:Name="TabTokens" Content="Токены" GroupName="Tabs"
                             Checked="Tab_Checked" Margin="0,0,16,0"
                             FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                             Foreground="{DynamicResource DarkTextBrush}"/>
                <RadioButton x:Name="TabPrompts" Content="Запросы" GroupName="Tabs"
                             Checked="Tab_Checked"
                             FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                             Foreground="{DynamicResource DarkTextBrush}"/>
            </StackPanel>

            <!-- Панель Метрики -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" x:Name="PanelMetrics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Метрики по умолчанию" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="MetricsGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Width="*" Binding="{Binding MetricName}"/>
                                <DataGridTextColumn Header="Тип" Width="*" Binding="{Binding MetricType}"/>
                                <DataGridTextColumn Header="Порог" Width="*" Binding="{Binding DefaultThreshold}"/>
                                <DataGridTemplateColumn Header="Активно" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center"
                                                      Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Добавить метрику" Style="{StaticResource OutlineButton}"
                            Click="AddMetricButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="12,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                </Grid>
            </Border>

            <!-- Панель Маркеры -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" x:Name="PanelMarkers" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Маркеры по умолчанию" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="MarkersGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Фраза" Width="*" Binding="{Binding Phrase}"/>
                                <DataGridTextColumn Header="Тип" Width="*" Binding="{Binding RequirementType}"/>
                                <DataGridTemplateColumn Header="Активно" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center"
                                                      Checked="MarkerCheckBox_Changed" Unchecked="MarkerCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Добавить маркер" Style="{StaticResource OutlineButton}"
                            Click="AddMarkerButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="12,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                </Grid>
            </Border>

            <!-- Панель Токены -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" x:Name="PanelTokens" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Токены" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="TokensGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Значение" Width="*" Binding="{Binding TokenValue}"/>
                                <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Description}"/>
                                <DataGridTemplateColumn Header="Активно" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center"
                                                      Checked="TokenCheckBox_Changed" Unchecked="TokenCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Добавить токен" Style="{StaticResource OutlineButton}"
                            Click="AddTokenButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="12,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                </Grid>
            </Border>

            <!-- Панель Запросы -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" x:Name="PanelPrompts" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Запросы по умолчанию" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="PromptsGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип" Width="*" Binding="{Binding PromptType}"/>
                                <DataGridTextColumn Header="Системный запрос" Width="2*" Binding="{Binding SystemPrompt}"/>
                                <DataGridTemplateColumn Header="Активно" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center"
                                                      Checked="PromptCheckBox_Changed" Unchecked="PromptCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Добавить запрос" Style="{StaticResource OutlineButton}"
                            Click="AddPromptButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Padding="12,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>