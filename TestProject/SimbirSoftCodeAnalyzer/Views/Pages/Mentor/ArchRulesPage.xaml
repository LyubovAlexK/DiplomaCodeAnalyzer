<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Mentor.ArchRulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Архитектурные правила" Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- Форма добавления -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="Добавить правило" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название:" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeH4}" 
                                   FontFamily="Inter" Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0" Width="130"/>
                        <TextBox Grid.Column="1" x:Name="RuleNameBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Пространство:" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeH4}" 
                                   FontFamily="Inter" Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0" Width="130"/>
                        <TextBox Grid.Column="1" x:Name="SourceNsBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Запрещено:" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeH4}" 
                                   FontFamily="Inter" Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0" Width="130"/>
                        <TextBox Grid.Column="1" x:Name="ForbiddenNsBox" Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>

                    <Button Content="Добавить правило" Style="{StaticResource PrimaryButton}"
                            Click="AddRuleButton_Click" HorizontalAlignment="Left" Padding="20,10"
                            FontSize="{DynamicResource AppFontSizeH4}"/>
                </StackPanel>
            </Border>

            <!-- Список правил -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Список правил" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="RulesGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  RowHeight="44" MaxHeight="400" HorizontalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Width="*" Binding="{Binding RuleName}"/>
                                <DataGridTextColumn Header="Пространство" Width="*" Binding="{Binding SourceNs}"/>
                                <DataGridTextColumn Header="Запрещено" Width="*" Binding="{Binding ForbiddenNs}"/>
                                <DataGridTemplateColumn Header="Активно" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      Checked="RuleActiveCheckBox_Changed"
                                                      Unchecked="RuleActiveCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Удалить правило" Style="{StaticResource DangerButton}"
                                Click="DeleteRuleButton_Click" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Padding="15,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                    <TextBlock Grid.Row="3" Text="Флажок — включает/отключает правило"
                               Style="{StaticResource H4Text}" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>