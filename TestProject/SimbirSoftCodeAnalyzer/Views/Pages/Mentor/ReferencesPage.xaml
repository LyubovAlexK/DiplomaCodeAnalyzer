<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Mentor.ReferencesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Эталонные проекты" Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- Загрузка эталона -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="Загрузить эталон" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RefPathTextBox" Text="Папка не выбрана" IsReadOnly="True"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Обзор" Style="{StaticResource OutlineButton}"
                                Click="BrowseRefButton_Click" Margin="10,0,0,0" Padding="15,8"
                                FontSize="{DynamicResource AppFontSizeH4}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ТЗ:" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeH4}" 
                                   FontFamily="Inter" Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0" Width="40"/>
                        <ComboBox Grid.Column="1" x:Name="SpecCombo" Style="{StaticResource CustomComboBox}"/>
                    </Grid>
                    <Button Content="Анализировать эталон" Style="{StaticResource PrimaryButton}"
                            Click="AnalyzeRefButton_Click" HorizontalAlignment="Left" Padding="20,10"
                            FontSize="{DynamicResource AppFontSizeH4}"/>
                </StackPanel>
            </Border>

            <!-- Список эталонов -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список эталонов" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="ReferencesGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="ReferencesGrid_MouseDoubleClick" RowHeight="44"
                                  MaxHeight="180" HorizontalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ТЗ" Width="*" Binding="{Binding SpecTitle}"/>
                                <DataGridTextColumn Header="Путь" Width="2*" Binding="{Binding ProjectPath}"/>
                                <DataGridTextColumn Header="Методов" Width="*" Binding="{Binding TotalMethods}"/>
                                <DataGridTextColumn Header="Сложность" Width="*" Binding="{Binding AvgComplexity}"/>
                                <DataGridTextColumn Header="Дата" Width="*" Binding="{Binding Date}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Удалить эталон" Style="{StaticResource DangerButton}"
                            Click="DeleteRefButton_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="15,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                    <TextBlock Grid.Row="3" Text="Двойной клик по строке — настройка правил сравнения"
                            Style="{StaticResource H4Text}" Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <!-- Правила сравнения -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16"
                    x:Name="RulesPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="RulesTitle" Text="Правила сравнения" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="RulesGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" RowHeight="44" MaxHeight="200"
                                  HorizontalAlignment="Stretch" CellEditEnding="RulesGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Метрика" Width="*" Binding="{Binding Метрика}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Тип" Width="*" Binding="{Binding Тип}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Порог" Width="*" Binding="{Binding ThresholdValue}"/>
                                <DataGridTemplateColumn Header="Вкл" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      Checked="RuleCheckBox_Changed"
                                                      Unchecked="RuleCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="2" Content="Сохранить изменения" Style="{StaticResource PrimaryButton}"
                            Click="SaveRulesButton_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Padding="15,8" FontSize="{DynamicResource AppFontSizeH4}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>