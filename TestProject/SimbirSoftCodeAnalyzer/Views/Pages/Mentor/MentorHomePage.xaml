<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Mentor.MentorHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Главное меню наставника" Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- KPI -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="KpiCard_Click" Tag="Results">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource PrimaryBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/users_89368.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TotalTraineesText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Стажёров" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0"
                        Cursor="Hand" MouseLeftButtonDown="KpiCard_Click" Tag="Results">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource SuccessBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/checked_89335.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PassedText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Сдали" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0"
                        Cursor="Hand" MouseLeftButtonDown="KpiCard_Click" Tag="Results">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource WarningBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/clock_89391.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="InProgressText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="В процессе" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}" Margin="8,0,0,0"
                        Cursor="Hand" MouseLeftButtonDown="KpiCard_Click" Tag="Results">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource PrimaryBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/stats_89319.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AvgMatchText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Средний %" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- График прогресса -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Прогресс стажёров" Style="{StaticResource H2Text}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Text="% соответствия по попыткам" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                    <!-- Плашка с итогами -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10" x:Name="SummaryPanel" Visibility="Visible">
                        <TextBlock x:Name="BestWorstText" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                            Foreground="{DynamicResource DarkTextBrush}" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                    <Border Grid.Row="2" x:Name="BarTooltip" Background="#1E293B" CornerRadius="6" Padding="10,6"
                            Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BarTooltipAttempt" FontSize="12" FontFamily="Inter" Foreground="#94A3B8"/>
                            <TextBlock x:Name="BarTooltipValue" FontSize="12" FontFamily="Inter" FontWeight="Bold"
                                    Foreground="White" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                Background="Transparent">
                        <Canvas x:Name="MentorChartCanvas" Background="Transparent" ClipToBounds="True"
                                    MouseWheel="MentorChartCanvas_MouseWheel"/>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="3" x:Name="LegendPanel" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Таблица + Кольцевая диаграмма -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Таблица стажёров -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Стажёры" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                        <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                            <DataGrid x:Name="TraineesGrid" Style="{StaticResource SmartDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44"
                                      MaxHeight="300"
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Стажёр" Width="*" Binding="{Binding TraineeName}"/>
                                    <DataGridTextColumn Header="Проект" Width="*" Binding="{Binding ProjectTitle}"/>
                                    <DataGridTextColumn Header="Попыток" Width="70" Binding="{Binding Attempts}"/>
                                    <DataGridTextColumn Header="Последний %" Width="90" Binding="{Binding LastPercent}"/>
                                    <DataGridTemplateColumn Header="Статус" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center"
                                                        Background="{Binding StatusBg}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontFamily="Inter"
                                                               FontWeight="SemiBold" Foreground="{Binding StatusFg}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Кольцевая диаграмма -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Статусы" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>
                        <Canvas Grid.Row="1" x:Name="DonutCanvas" Width="300" Height="220" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            <Button Grid.Row="4" Content="Сводный отчёт" Style="{StaticResource OutlineButton}"
                Click="ExportAllPdf_Click" HorizontalAlignment="Right" Padding="15,8"
                FontSize="{DynamicResource AppFontSizeH4}"/>
        </Grid>
    </ScrollViewer>
</UserControl>