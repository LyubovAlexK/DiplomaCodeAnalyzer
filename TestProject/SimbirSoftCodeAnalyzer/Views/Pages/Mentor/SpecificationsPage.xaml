<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Mentor.SpecificationsPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 mc:Ignorable="d" 
                 d:DesignHeight="650" d:DesignWidth="950"
                 Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ТЗ и требования" Style="{StaticResource H1Text}"/>
                <Button x:Name="HelpButton" Content="?" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource IconButtonStyle}" FontSize="14"
                        Click="HelpButton_Click"/>
            </Grid>

            <Popup x:Name="HelpPopup" 
       Placement="Bottom"
       StaysOpen="False"
       AllowsTransparency="True">
                <Border Background="White" 
            CornerRadius="10" 
            Padding="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Подсказки" Style="{StaticResource H3Text}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Маркеры — ключевые фразы, по которым локальный анализатор находит требования в тексте ТЗ." 
                       Style="{StaticResource H4Text}" Margin="0,0,0,4" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock Text="Примеры: «система должна», «просмотр списка», «необходимо реализовать»." 
                       Style="{StaticResource H4Text}" Margin="0,0,0,10" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock Text="Запросы — инструкции для ИИ (GigaChat), как именно извлекать требования или проверять код." 
                       Style="{StaticResource H4Text}" Margin="0,0,0,4" TextWrapping="Wrap" MaxWidth="300"/>
                        <TextBlock Text="Меняйте запросы, если хотите улучшить качество анализа." 
                       Style="{StaticResource H4Text}" TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Загрузка ТЗ -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="Загрузка ТЗ" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TzPathTextBox" Text="Файл не выбран" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        <Button Grid.Column="1" Content="Обзор" Style="{StaticResource OutlineButton}"
                                    Click="BrowseTzButton_Click" Margin="10,0,0,0" Padding="15,8"
                                    FontSize="{DynamicResource AppFontSizeH4}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="LocalRadio" Content="Локальный" IsChecked="True" 
                                         GroupName="AnalysisMode" Margin="0,0,20,0"
                                         FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                         Foreground="{DynamicResource DarkTextBrush}"/>
                        <RadioButton x:Name="AiRadio" Content="ИИ (GigaChat)" GroupName="AnalysisMode"
                                         FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                         Foreground="{DynamicResource DarkTextBrush}"/>
                    </StackPanel>
                    <Button x:Name="AnalyzeTzButton" Content="Запустить анализ" Style="{StaticResource PrimaryButton}"
                                Click="AnalyzeTzButton_Click" HorizontalAlignment="Left" Padding="20,10"
                                FontSize="{DynamicResource AppFontSizeH4}"/>
                    <!-- Прогресс анализа ТЗ -->
                    <Border x:Name="AnalysisProgressBorder" Visibility="Collapsed" 
                                    Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="AnalysisStatusText" Text="Подготовка..."
                                   Style="{StaticResource H4Text}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="AnalysisProgressBar" Height="6" 
                                         IsIndeterminate="True"
                                         Style="{StaticResource ModernProgressBar}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Список ТЗ -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Список технических заданий" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="SpecsGrid" Style="{StaticResource SmartDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      SelectionChanged="SpecsGrid_SelectionChanged" RowHeight="44"
                                      MaxHeight="180" HorizontalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Title}"/>
                                <DataGridTextColumn Width="*" Binding="{Binding ТипАнализа}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Тип анализа"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Дата" Width="*" Binding="{Binding Дата}"/>
                                <DataGridTextColumn Header="Требований" Width="*" Binding="{Binding Требований}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Требования -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16"
                        x:Name="RequirementsPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RequirementsTitle" Text="Требования" Style="{StaticResource H2Text}"/>
                        <Button Grid.Column="1" Content="Добавить требование" Style="{StaticResource PrimaryButton}"
                                    Click="AddRequirement_Click" Padding="15,8"
                                    FontSize="{DynamicResource AppFontSizeH4}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Удалить" Style="{StaticResource DangerButton}"
                                    Click="DeleteRequirement_Click" Padding="15,8"
                                    FontSize="{DynamicResource AppFontSizeH4}"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="RequirementsGrid" Style="{StaticResource SmartDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44"
                                      MaxHeight="250" HorizontalAlignment="Stretch"
                                      MouseDoubleClick="RequirementsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Использовать"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          Checked="RequirementCheckBox_Changed"
                                                          Unchecked="RequirementCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Тип" Width="*" Binding="{Binding Тип}"/>
                                <DataGridTextColumn Header="Название" Width="2*" Binding="{Binding Title}"/>
                                <DataGridTemplateColumn Header="Важность" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center"
                                                        Background="{Binding SeverityBg}">
                                                <TextBlock Text="{Binding Важность}" FontSize="11" FontFamily="Inter"
                                                               FontWeight="SemiBold" Foreground="{Binding SeverityFg}"
                                                               HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✏" Width="30" Height="30"
                                                        Style="{StaticResource IconButtonStyle}" FontSize="14"
                                                        Click="EditRequirement_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Флажок — участвует в проверке. Значок редактирования — изменить требование"
                                   Style="{StaticResource H4Text}" Margin="0,8,0,0"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Маркеры требований" Style="{StaticResource OutlineButton}"
                                    FontSize="{DynamicResource AppFontSizeH4}" Padding="12,8" Margin="0,0,10,0"
                                    Click="MarkersButton_Click"/>
                        <Button Content="Настройка запросов" Style="{StaticResource OutlineButton}"
                                    FontSize="{DynamicResource AppFontSizeH4}" Padding="12,8"
                                    Click="PromptsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>