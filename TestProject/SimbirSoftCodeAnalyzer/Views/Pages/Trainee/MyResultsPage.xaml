<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Trainee.MyResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок + выбор проекта -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Мои результаты" Style="{StaticResource H1Text}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Проект:" VerticalAlignment="Center" 
                               FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                               Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProjectFilterCombo" Style="{StaticResource CustomComboBox}" Width="220"
                              SelectionChanged="ProjectFilterCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Подсказка -->
            <TextBlock Grid.Row="0" x:Name="PlaceholderText"
                       Text="Выберите проект, чтобы увидеть результаты проверки"
                       FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Visibility="Visible" Margin="0,40,0,0" HorizontalAlignment="Center"/>

            <!-- Статус готовности + Кнопки -->
            <Border Grid.Row="1" x:Name="StatusPanel" Visibility="Collapsed" 
        Style="{StaticResource CardBorder}" Margin="0,0,0,15" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Статус -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Загрузка..." Style="{StaticResource H3Text}"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SendToMentorBtn" Content="Отправить наставнику" 
                    Style="{StaticResource PrimaryButton}"
                    Click="SendToMentor_Click" Margin="0,0,10,0" Padding="16,10"
                    FontSize="{DynamicResource AppFontSizeH4}"/>
                        <Button Content="Экспорт в PDF" Style="{StaticResource OutlineButton}"
                    Click="ExportPdf_Click" Padding="16,10"
                    FontSize="{DynamicResource AppFontSizeH4}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI -->
            <Grid Grid.Row="2" x:Name="KpiGrid" Margin="0,0,0,20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource PrimaryBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/stats_89319.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MatchPercentText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Соответствие" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource DangerBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/warning_89399.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RoslynFailText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Синтаксис" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource WarningBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/clipboard_89387.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ArchFailText" Text="—"
                                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Архитектура" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <Rectangle Width="20" Height="20" Fill="{DynamicResource InfoBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/anchor_89316.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RefMatchText" Text="—"
                       FontSize="{DynamicResource AppFontSizeBig}" FontFamily="Inter" FontWeight="Bold"
                       Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="Соотв. эталону" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Таблица вердиктов -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" 
                    x:Name="VerdictsPanel" Visibility="Collapsed" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Нарушения" Style="{StaticResource H2Text}"/>
                        <ComboBox Grid.Column="1" x:Name="VerdictTypeCombo" Style="{StaticResource CustomComboBox}" Width="150"
                                  HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="VerdictTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Все типы" Tag="all"/>
                            <ComboBoxItem Content="Синтаксис" Tag="Синтаксис"/>
                            <ComboBoxItem Content="Архитектура" Tag="Архитектура"/>
                            <ComboBoxItem Content="Семантика" Tag="Семантика"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource InputBorder}" Margin="0,0,0,12" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/icons/search_89415.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBox Grid.Column="1" x:Name="VerdictSearchBox" Style="{StaticResource InputBox}"
                                     TextChanged="VerdictSearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="VerdictsGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="VerdictsGrid_MouseDoubleClick" RowHeight="40" MaxHeight="300"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип" Width="100" Binding="{Binding AiModel}"/>
                                <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Reason}"/>
                                <DataGridTextColumn Header="Расположение" Width="150" Binding="{Binding CodeLocation}"/>
                                <DataGridTemplateColumn Header="Тип" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center"
                                                    Background="{Binding TypeBg}">
                                                <TextBlock Text="{Binding TypeText}" FontSize="11" FontFamily="Inter"
                                                           FontWeight="SemiBold" Foreground="{Binding TypeFg}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Сравнение с эталоном + График -->
            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,10,0,0"
        x:Name="ReferencePanel" Visibility="Collapsed" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Сравнение с эталоном" Style="{StaticResource H2Text}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" x:Name="ReferenceText" 
                   FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource DarkTextBrush}" TextWrapping="Wrap" LineHeight="22"
                   Margin="0,0,0,10"/>

                    <!-- График с двумя линиями -->
                    <Canvas Grid.Row="2" x:Name="ComparisonCanvas" Background="Transparent" ClipToBounds="True"/>

                    <!-- Легенда -->
                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="3" Fill="{DynamicResource PrimaryBrush}" 
                           RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Соответствие ТЗ" Style="{StaticResource H4Text}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="12" Height="3" Fill="{DynamicResource SuccessBrush}" 
                           RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Соответствие эталону" Style="{StaticResource H4Text}"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>