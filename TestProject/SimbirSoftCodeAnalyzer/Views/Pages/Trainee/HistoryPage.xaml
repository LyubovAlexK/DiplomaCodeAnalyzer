<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Trainee.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок + выбор проекта -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Мой прогресс" Style="{StaticResource H1Text}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Проект:" VerticalAlignment="Center" 
                               FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                               Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProjectChartCombo" Style="{StaticResource CustomComboBox}" Width="220"
                              SelectionChanged="ProjectChartCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Подсказка -->
            <TextBlock Grid.Row="0" x:Name="PlaceholderText"
                       Text="Выберите проект, чтобы увидеть прогресс"
                       FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Visibility="Visible" Margin="0,40,0,0" HorizontalAlignment="Center"/>

            <!-- График -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20"
        x:Name="ChartPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Прогресс по попыткам" Style="{StaticResource H2Text}"/>
                        <TextBlock Grid.Column="1" x:Name="BestResultLabel"
                       Text="" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="% соответствия" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                    <!-- Контейнер с обрезкой + скролл -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Background="#F8F9FA">
                        <Canvas x:Name="ProgressCanvas" Background="Transparent" ClipToBounds="True"
                    MouseMove="ProgressCanvas_MouseMove" MouseLeave="ProgressCanvas_MouseLeave"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" x:Name="BarTooltip" Background="#1E293B" CornerRadius="6" Padding="10,6"
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BarTooltipAttempt" FontSize="12" FontFamily="Inter" Foreground="#94A3B8"/>
                            <TextBlock x:Name="BarTooltipValue" FontSize="12" FontFamily="Inter" FontWeight="Bold"
                           Foreground="White" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" x:Name="BestSessionLabel" FontSize="{DynamicResource AppFontSizeH4}" FontFamily="Inter"
                   Foreground="{DynamicResource SuccessBrush}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Таблица -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" x:Name="TablePanel" Visibility="Collapsed" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Попытки" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="SessionsGrid" Style="{StaticResource SmartDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="SessionsGrid_MouseDoubleClick" RowHeight="44"
                                  MaxHeight="400"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Попытка" Width="80" Binding="{Binding AttemptNumber}"/>
                                <DataGridTextColumn Header="%" Width="80" Binding="{Binding PercentText}"/>
                                <DataGridTemplateColumn Header="Индикатор" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Статус" Width="100" Binding="{Binding StatusText}"/>
                                <DataGridTextColumn Header="Дата" Width="160" Binding="{Binding DateText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>