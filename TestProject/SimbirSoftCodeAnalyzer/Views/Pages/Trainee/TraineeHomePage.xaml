<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Trainee.TraineeHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Главное меню"
                       Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- Ярус 1: Карточки KPI -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Моих проектов -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8">
                                <Rectangle Width="20" Height="20" Fill="{DynamicResource PrimaryBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/folder_89347.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="MyProjectsText" Text="—"
                                       FontSize="36" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Моих проектов"
                                   Style="{StaticResource H3Text}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Всего попыток -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8">
                                <Rectangle Width="20" Height="20" Fill="{DynamicResource PrimaryBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/refresh_89350.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="TotalAttemptsText" Text="—"
                                       FontSize="36" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Всего попыток"
                                   Style="{StaticResource H3Text}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Лучший результат -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}" Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8">
                                <Rectangle Width="20" Height="20" Fill="{DynamicResource SuccessBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/stats_89319.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="BestResultText" Text="—"
                                       FontSize="36" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Лучший результат"
                                   Style="{StaticResource H3Text}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Сдано проектов -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="40" Height="40" Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="8">
                                <Rectangle Width="20" Height="20" Fill="{DynamicResource WarningBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/checked_89335.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <TextBlock x:Name="CompletedText" Text="—"
                                       FontSize="36" FontFamily="Inter" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Сдано"
                                   Style="{StaticResource H3Text}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Ярус 2: Активные проекты -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Активные проекты" Style="{StaticResource H2Text}" Margin="0,0,0,15"/>
                    <StackPanel x:Name="ActiveProjectsPanel"/>
                </StackPanel>
            </Border>

            <!-- Ярус 3: График прогресса + Последняя сессия -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- График прогресса -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Мой прогресс" Style="{StaticResource H2Text}"/>
                            <TextBlock Grid.Column="1" x:Name="BestResultLabel"
                       Text="" FontSize="13" FontFamily="Inter"
                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="2" x:Name="ProjectChartCombo"
                      Style="{StaticResource CustomComboBox}" Width="180"
                      SelectionChanged="ProjectChartCombo_SelectionChanged"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="% соответствия по попыткам"
                   FontSize="13" FontFamily="Inter"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                        <Canvas Grid.Row="2" x:Name="ProgressCanvas"
                Background="Transparent" ClipToBounds="True"
                MouseMove="ProgressCanvas_MouseMove"
                MouseLeave="ProgressCanvas_MouseLeave"/>
                        <!-- Tooltip для столбца -->
                        <Border Grid.Row="2" x:Name="BarTooltip"
                Background="#1E293B" CornerRadius="6" Padding="10,6"
                Visibility="Collapsed" HorizontalAlignment="Left"
                VerticalAlignment="Top" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BarTooltipAttempt" FontSize="12" FontFamily="Inter"
                           Foreground="#94A3B8"/>
                                <TextBlock x:Name="BarTooltipValue" FontSize="12" FontFamily="Inter"
                           FontWeight="Bold" Foreground="White" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Последняя проверка -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <!-- Заголовок -->
                        <TextBlock Text="Последняя проверка" 
                   Style="{StaticResource H2Text}" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

                        <!-- Круглая диаграмма -->
                        <Canvas x:Name="GaugeCanvas" 
                Width="120" Height="120"
                HorizontalAlignment="Center"/>

                        <!-- Процент -->
                        <TextBlock x:Name="GaugePercentText"
                   FontSize="24" FontFamily="Inter" FontWeight="Bold"
                   Foreground="{DynamicResource DarkTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                        <TextBlock Text="Соответствие"
                   Style="{StaticResource H4Text}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,12"/>

                        <!-- Легенда -->
                        <StackPanel x:Name="LegendPanel2" Margin="0,0,0,12"/>

                        <!-- Кнопка -->
                        <Button Content="Смотреть детали"
                Style="{StaticResource OutlineButton}"
                HorizontalAlignment="Stretch"
                Padding="12,8"
                FontSize="{DynamicResource AppFontSizeH4}"
                Click="ViewDetails_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>