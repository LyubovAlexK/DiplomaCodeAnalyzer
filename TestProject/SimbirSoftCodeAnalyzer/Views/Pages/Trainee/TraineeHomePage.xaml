<UserControl x:Class="SimbirSoftCodeAnalyzer.Views.Pages.Trainee.TraineeHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Моё главное меню"
                       Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

            <!-- Ярус 1: График прогресса -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📊 Мой прогресс" Style="{StaticResource H2Text}"/>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="% по ТЗ" FontSize="12" FontFamily="Inter" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,15,0"/>
                            <Border Width="12" Height="12" Background="{DynamicResource SuccessBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="% по эталону" FontSize="12" FontFamily="Inter" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Заглушка графика -->
                    <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="8" Margin="0,10,0,0">
                        <Canvas>
                            <Polyline Points="30,160 120,130 220,110 320,90 420,75 520,55"
                                      Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.5"/>
                            <Polyline Points="30,150 120,115 220,95 320,70 420,55 520,35"
                                      Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.5"/>
                        </Canvas>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <TextBlock Text="П1" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="П2" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="{Binding RelativeSource={RelativeSource Self}}" Margin="120,0,0,0"/>
                        <TextBlock Text="П3" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="{Binding RelativeSource={RelativeSource Self}}" Margin="220,0,0,0"/>
                        <TextBlock Text="П4" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="{Binding RelativeSource={RelativeSource Self}}" Margin="320,0,0,0"/>
                        <TextBlock Text="П5" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="{Binding RelativeSource={RelativeSource Self}}" Margin="420,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Ярус 2: Текущая сессия + Цель -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Текущая сессия -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📈 Текущая сессия" Style="{StaticResource H2Text}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="% ТЗ:" FontSize="15" Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="88%" FontSize="20" FontWeight="Bold" FontFamily="Inter"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#EDF2F6" CornerRadius="3" Margin="0,0,0,15">
                            <Border Width="264" Background="{DynamicResource PrimaryBrush}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Border>

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="% Эталон:" FontSize="15" Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="92%" FontSize="20" FontWeight="Bold" FontFamily="Inter"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#EDF2F6" CornerRadius="3" Margin="0,0,0,15">
                            <Border Width="276" Background="{DynamicResource SuccessBrush}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Border>

                        <TextBlock Text="🟢 Выше порога" FontSize="13" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Цель -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🎯 Моя цель" Style="{StaticResource H2Text}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="До сдачи:" FontSize="15" Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="85%" FontSize="20" FontWeight="Bold" FontFamily="Inter"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Осталось:" FontSize="15" Foreground="{DynamicResource DarkTextBrush}"/>
                            <TextBlock Text="3 дня" FontSize="20" FontWeight="Bold" FontFamily="Inter"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Прогресс" FontSize="14" Foreground="{DynamicResource DarkTextBrush}" Margin="0,0,0,8"/>
                        <Border Height="8" Background="#EDF2F6" CornerRadius="4">
                            <Border Width="240" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock Text="80%" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ярус 3: История проверок -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📋 Мои проверки" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource DataGridCardBorder}">
                        <DataGrid x:Name="HistoryGrid"
                                  Style="{StaticResource CustomDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Width="100" Binding="{Binding Date}"/>
                                <DataGridTextColumn Header="% ТЗ" Width="80" Binding="{Binding TzPercent}"/>
                                <DataGridTextColumn Header="% Эталон" Width="80" Binding="{Binding RefPercent}"/>
                                <DataGridTextColumn Header="Roslyn" Width="70" Binding="{Binding RoslynIssues}"/>
                                <DataGridTextColumn Header="Arch" Width="70" Binding="{Binding ArchIssues}"/>
                                <DataGridTextColumn Header="AI" Width="70" Binding="{Binding AiIssues}"/>
                                <DataGridTemplateColumn Header="Статус" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,3"
                                                    Background="{Binding StatusColor}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Ярус 4: Последние замечания -->
            <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="🔍 Последние замечания" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock Text="🔴 Цикломатическая сложность 47 — AddEditPanel" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="🟡 Исполняемых строк 26 — UpdateEventInDatabase" FontSize="13" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>