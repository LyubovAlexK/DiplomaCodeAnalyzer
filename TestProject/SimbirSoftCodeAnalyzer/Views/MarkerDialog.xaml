<Window x:Class="SimbirSoftCodeAnalyzer.Views.MarkerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маркер требования" Width="450" Height="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" Icon="/Resources/Images/logo-simbirsoft.png"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Фраза:" Style="{StaticResource H4Text}" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" x:Name="PhraseBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Тип требования:" Style="{StaticResource H4Text}" Margin="0,0,0,6"/>
                <ComboBox x:Name="TypeCombo" Style="{StaticResource CustomComboBox}">
                    <ComboBoxItem Content="Функциональное" Tag="Functional"/>
                    <ComboBoxItem Content="Архитектурное" Tag="Architectural"/>
                    <ComboBoxItem Content="Метрика" Tag="Metric"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Важность:" Style="{StaticResource H4Text}" Margin="0,0,0,6"/>
                <ComboBox x:Name="SeverityCombo" Style="{StaticResource CustomComboBox}">
                    <ComboBoxItem Content="Критично" Tag="Fatal"/>
                    <ComboBoxItem Content="Важно" Tag="Major"/>
                    <ComboBoxItem Content="Средне" Tag="Minor"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                    Padding="20,8" Margin="0,0,10,0" FontSize="{DynamicResource AppFontSizeH4}"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"
                    Padding="20,8" FontSize="{DynamicResource AppFontSizeH4}" x:Name="DeleteBtn" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>