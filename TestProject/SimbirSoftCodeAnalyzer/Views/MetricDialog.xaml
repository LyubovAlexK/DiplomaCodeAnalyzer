<Window x:Class="SimbirSoftCodeAnalyzer.Views.MetricDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Метрика" Width="400" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" Icon="/Resources/Images/logo-simbirsoft.png"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="NameBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Тип:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3" x:Name="TypeCombo" Style="{StaticResource CustomComboBox}" Margin="0,0,0,12">
            <ComboBoxItem Content="Roslyn" Tag="Roslyn"/>
            <ComboBoxItem Content="NetArchTest" Tag="NetArchTest"/>
            <ComboBoxItem Content="AI" Tag="AI"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Порог:" Style="{StaticResource H4Text}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5" x:Name="ThresholdBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

        <Button Grid.Row="6" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                Click="SaveButton_Click" HorizontalAlignment="Right" Padding="20,8"
                FontSize="{DynamicResource AppFontSizeH4}"/>
    </Grid>
</Window>