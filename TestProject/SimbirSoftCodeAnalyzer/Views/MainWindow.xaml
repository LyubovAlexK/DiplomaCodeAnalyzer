<Window x:Class="SimbirSoftCodeAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimbirSoftCodeAnalyzer.Views"
        xmlns:pages="clr-namespace:SimbirSoftCodeAnalyzer.Views.Pages"
        Title="SimbirSoft Code Analyzer"
        MinHeight="700" MinWidth="1100"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CornerRadius="0"
                      CaptionHeight="40"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource GlobalBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== БОКОВОЕ МЕНЮ ===== -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Margin="20,30,20,20">
                        <TextBlock Text="SCA"
                                   FontSize="28"
                                   FontFamily="Inter"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Code Analyzer"
                                   FontSize="12"
                                   FontFamily="Inter"
                                   Foreground="#B3B3B3"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Пункты меню -->
                    <StackPanel Grid.Row="1" Margin="10,0">
                        <!-- Главная -->
                        <Button x:Name="BtnHome"
                                Style="{StaticResource SidebarActiveButton}"
                                Content="🏠  Главная"
                                Click="MenuButton_Click"
                                Tag="Home"/>

                        <!-- Админ: Пользователи -->
                        <Button x:Name="BtnUsers"
                                Style="{StaticResource SidebarButton}"
                                Content="👥  Пользователи"
                                Click="MenuButton_Click"
                                Tag="Users"
                                Visibility="Collapsed"/>

                        <!-- Админ: Системные ресурсы -->
                        <Button x:Name="BtnSystemResources"
                                Style="{StaticResource SidebarButton}"
                                Content="⚙  Системные ресурсы"
                                Click="MenuButton_Click"
                                Tag="SystemResources"
                                Visibility="Collapsed"/>

                        <!-- Наставник: Управление проверками -->
                        <Button x:Name="BtnCheckManagement"
                                Style="{StaticResource SidebarButton}"
                                Content="📋  Проверки"
                                Click="MenuButton_Click"
                                Tag="CheckManagement"
                                Visibility="Collapsed"/>

                        <!-- Наставник: Результаты -->
                        <Button x:Name="BtnResults"
                                Style="{StaticResource SidebarButton}"
                                Content="📊  Результаты"
                                Click="MenuButton_Click"
                                Tag="Results"
                                Visibility="Collapsed"/>

                        <!-- Стажёр: Мой код -->
                        <Button x:Name="BtnMyCode"
                                Style="{StaticResource SidebarButton}"
                                Content="💻  Мой код"
                                Click="MenuButton_Click"
                                Tag="MyCode"
                                Visibility="Collapsed"/>

                        <!-- Стажёр: Мои результаты -->
                        <Button x:Name="BtnMyResults"
                                Style="{StaticResource SidebarButton}"
                                Content="📈  Мои результаты"
                                Click="MenuButton_Click"
                                Tag="MyResults"
                                Visibility="Collapsed"/>

                        <!-- Настройки -->
                        <Button x:Name="BtnSettings"
                                Style="{StaticResource SidebarButton}"
                                Content="🔧  Настройки"
                                Click="MenuButton_Click"
                                Tag="Settings"/>
                    </StackPanel>

                    <!-- Нижняя часть: выход -->
                    <StackPanel Grid.Row="2" Margin="10,0,10,20">
                        <Button Style="{StaticResource SidebarButton}"
                                Content="🚪  Выход"
                                Click="ExitButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== ОБЛАСТЬ КОНТЕНТА ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка с заголовком и кнопками -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SimbirSoft Code Analyzer"
                                   VerticalAlignment="Center"
                                   Margin="15,0"
                                   Foreground="{DynamicResource DarkTextBrush}"
                                   FontSize="14"
                                   FontFamily="Inter"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="─"
                                    Foreground="{DynamicResource DarkTextBrush}"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="MinimizeButton_Click"/>
                            <Button Content="□"
                                    Foreground="{DynamicResource DarkTextBrush}"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="MaximizeButton_Click"/>
                            <Button Content="×"
                                    Foreground="{DynamicResource DarkTextBrush}"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Контент (здесь загружаются панели) -->
                <ContentControl Grid.Row="1" 
                                x:Name="ContentArea"
                                Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>