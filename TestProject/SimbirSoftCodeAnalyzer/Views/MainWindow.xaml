<Window x:Class="SimbirSoftCodeAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimbirSoftCodeAnalyzer.Views"
        xmlns:pages="clr-namespace:SimbirSoftCodeAnalyzer.Views.Pages"
        Title="SimbirSoft Анализатор кода"
        MinHeight="700" MinWidth="1100"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Icon="/Resources/Images/logo-simbirsoft.png">

    <Border Background="{DynamicResource GlobalBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== БОКОВОЕ МЕНЮ ===== -->
            <Border x:Name="SidebarPanel"
                    Grid.Column="0" 
                    Background="White"
                    BorderBrush="#E8ECF0"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Row="0" Margin="20,25,20,10">
                        <StackPanel x:Name="LogoPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Image Source="/Resources/Images/logo-simbirsoft.png"
                                   Width="40" Height="40"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Анализатор кода"
                                       FontSize="18"
                                       FontFamily="Inter"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Пункты меню -->
                    <StackPanel x:Name="MenuPanel" Grid.Row="1" Margin="12,0">

                        <!-- Главное меню -->
                        <Button x:Name="BtnHome"
                                Click="MenuButton_Click"
                                Tag="Home"
                                Style="{StaticResource SidebarActiveItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/home_89292.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Главное меню" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Пользователи -->
                        <Button x:Name="BtnUsers"
                                Click="MenuButton_Click"
                                Tag="Users"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/user_89269.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Пользователи" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Технические задания -->
                        <Button x:Name="BtnSystemResources"
                                Click="MenuButton_Click"
                                Tag="SystemResources"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/textlines_89351.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Технические задания" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                        </Button>

                        <!-- Мой код -->
                        <Button x:Name="BtnMyCode" Click="MenuButton_Click" Tag="MyCode"
        Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/computer_89404.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Мой код" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Мои результаты -->
                        <Button x:Name="BtnMyResults" Click="MenuButton_Click" Tag="MyResults"
        Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/stats_89319.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Мои результаты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- История -->
                        <Button x:Name="BtnHistory" Click="MenuButton_Click" Tag="History"
                                Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/clock_89391.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Мой прогресс" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Результаты (наставник) -->
                        <Button x:Name="BtnResults" Click="MenuButton_Click" Tag="Results"
        Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/stats_89319.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Результаты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Эталоны (наставник) -->
                        <Button x:Name="BtnReferences" Click="MenuButton_Click" Tag="References"
        Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/anchor_89316.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Эталоны" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Архитектурные правила (наставник) -->
                        <Button x:Name="BtnArchRules" Click="MenuButton_Click" Tag="ArchRules"
        Style="{StaticResource SidebarItemButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/clipboard_89387.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Арх. правила" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Настройки -->
                        <Button x:Name="BtnSettings"
                                Click="MenuButton_Click"
                                Tag="Settings"
                                Style="{StaticResource SidebarItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/settings_89381.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Нижний блок -->
                    <StackPanel x:Name="BottomPanel" Grid.Row="2" Margin="12,0,12,24">
                        <Border Height="1" Background="#E8ECF0" Margin="0,0,0,12"/>

                        <!-- Свернуть (как пункт меню) -->
                        <Button x:Name="CollapseMenuButton"
            Click="CollapseSidebar_Click"
            Style="{StaticResource SidebarItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/back_89271.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Свернуть" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Выход -->
                        <Button Click="ExitButton_Click"
            Style="{StaticResource SidebarItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource MenuIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/icons/signin_89278.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Выход" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Кнопка-капелька (видна только в свёрнутом режиме) -->
                    <Button x:Name="ExpandPillButton"
                            Grid.Row="2"
                            Click="ExpandSidebar_Click"
                            Width="44" Height="44"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-14,70"
                            Visibility="Collapsed"
                            Background="White"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="44" Height="44">
                                    <!-- Белый фон -->
                                    <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Width="44" Height="44"/>
   
                                    <!-- Обводка — только правая половина (полукруг) -->
                                    <Path Data="M 22,0 L 34,0 A 10,10 0 0,1 44,10 L 44,34 A 10,10 0 0,1 34,44 L 22,44"
                                          Stroke="#E8ECF0"
                                          StrokeThickness="1"
                                          Fill="Transparent"/>

                                    <!-- Иконка -->
                                    <Rectangle Width="20" Height="20" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{DynamicResource SecondaryTextColor}"/>
                                        </Rectangle.Fill>
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="/Resources/Images/icons/next_89378.png"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== ОБЛАСТЬ КОНТЕНТА ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0" 
                                x:Name="ContentArea"
                                Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>