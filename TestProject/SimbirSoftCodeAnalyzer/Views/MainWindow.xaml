<Window x:Class="SimbirSoftCodeAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimbirSoftCodeAnalyzer.Views"
        xmlns:pages="clr-namespace:SimbirSoftCodeAnalyzer.Views.Pages"
        Title="SimbirSoft Code Analyzer"
        MinHeight="700" MinWidth="1100"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource GlobalBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== БОКОВОЕ МЕНЮ ===== -->
            <Border Grid.Column="0" 
        Background="White"
        BorderBrush="#E8ECF0"
        BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Row="0" Margin="24,30,24,24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Image Source="/Resources/Images/logo-simbirsoft.png"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"/>
                            <TextBlock Text="Анализатор кода"
                                       FontSize="20"
                                       FontFamily="Inter"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DarkTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Пункты меню -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">

                        <!-- Главная -->
                        <Button x:Name="BtnHome"
                                Content="🏠  Главная"
                                Click="MenuButton_Click"
                                Tag="Home"
                                Foreground="{DynamicResource DarkTextBrush}"
                                Style="{StaticResource SidebarItemButton}"/>

                        <!-- Админ: Пользователи -->
                        <Button x:Name="BtnUsers"
                                Content="👥  Пользователи"
                                Click="MenuButton_Click"
                                Tag="Users"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Админ: Системные ресурсы -->
                        <Button x:Name="BtnSystemResources"
                                Content="⚙  Системные ресурсы"
                                Click="MenuButton_Click"
                                Tag="SystemResources"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Наставник: Проверки -->
                        <Button x:Name="BtnCheckManagement"
                                Content="📋  Проверки"
                                Click="MenuButton_Click"
                                Tag="CheckManagement"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Наставник: Результаты -->
                        <Button x:Name="BtnResults"
                                Content="📊  Результаты"
                                Click="MenuButton_Click"
                                Tag="Results"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Стажёр: Мой код -->
                        <Button x:Name="BtnMyCode"
                                Content="💻  Мой код"
                                Click="MenuButton_Click"
                                Tag="MyCode"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Стажёр: Мои результаты -->
                        <Button x:Name="BtnMyResults"
                                Content="📈  Мои результаты"
                                Click="MenuButton_Click"
                                Tag="MyResults"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"
                                Visibility="Collapsed"/>

                        <!-- Настройки -->
                        <Button x:Name="BtnSettings"
                                Content="🔧  Настройки"
                                Click="MenuButton_Click"
                                Tag="Settings"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"/>
                    </StackPanel>

                    <!-- Нижний блок -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,24">
                        <Border Height="1" 
                                Background="#E8ECF0" 
                                Margin="16,0,16,12"/>
                        <Button Content="🚪  Выход"
                                Click="ExitButton_Click"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource SidebarItemButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== ОБЛАСТЬ КОНТЕНТА ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка с заголовком и кнопками -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>

                <!-- Контент (здесь загружаются панели) -->
                <ContentControl Grid.Row="1" 
                                x:Name="ContentArea"
                                Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>